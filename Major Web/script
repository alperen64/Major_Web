    function formatEventDate(dateStr, timeStr) {
        if (!dateStr) return "";
        const parts = dateStr.split('-'); 
        if(parts.length !== 3) return timeStr ? `${dateStr} | ${timeStr}` : dateStr;
        
        const yil = parseInt(parts[0], 10);
        const ayIndex = parseInt(parts[1], 10) - 1;
        const gun = parseInt(parts[2], 10);
        
        const ay = aylarListesi[currentLang][ayIndex];
        const dateObj = new Date(yil, ayIndex, gun);
        const gunAdi = gunlerListesi[currentLang][dateObj.getDay()];
        
        if (timeStr) return `${gun} ${ay} ${gunAdi} ${yil} | ${timeStr.replace(':', '.')}`;
        else return `${gun} ${ay} ${gunAdi} ${yil}`;
    }

