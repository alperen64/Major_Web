<style>
        :root {
            --bg-color: #050505;
            --text-main: #ffffff; 
            --text-muted: #dcdcdc; 
            --vintage-red: #cc0000; 
            --vintage-red-hover: #ff1a1a;
            --green: #2e8b57;
            --border-radius: 15px; 
            --glass-bg: rgba(30, 30, 30, 0.4);
            --glass-border: rgba(255, 255, 255, 0.1);
        }
        
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Poppins', sans-serif; font-weight: 700; }
        
        body { 
            background-color: var(--bg-color); color: var(--text-main); 
            line-height: 1.6; position: relative; overflow-x: hidden; min-height: 100vh;
        }

        /* Daha Görünür Kırmızı Sahne Işıkları */
        body::before {
            content: ''; position: fixed; top: -150px; left: -150px; width: 700px; height: 700px;
            background: radial-gradient(circle, rgba(204,0,0,0.6) 0%, rgba(0,0,0,0) 70%);
            filter: blur(50px); z-index: -1; pointer-events: none;
        }
        body::after {
            content: ''; position: fixed; bottom: -150px; right: -150px; width: 700px; height: 700px;
            background: radial-gradient(circle, rgba(204,0,0,0.6) 0%, rgba(0,0,0,0) 70%);
            filter: blur(50px); z-index: -1; pointer-events: none;
        }
        
        /* HİZALANMIŞ HEADER */
        header {
            position: fixed; top: 0; left: 0; width: 100%; height: 90px;
            z-index: 1000; pointer-events: none;
        }
        .logo-image {
            position: absolute; top: 50%; left: 30px; transform: translateY(-50%);
            width: 70px; height: 70px; border-radius: 50%; cursor: pointer;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            object-fit: contain; background-color: #000; pointer-events: auto;
        }
        .logo-image:hover { transform: translateY(-50%) scale(1.1); box-shadow: 0 10px 20px rgba(204, 0, 0, 0.5); }

        .floating-nav {
            position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
            display: flex; gap: 15px; background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(15px); -webkit-backdrop-filter: blur(15px);
            padding: 10px 25px; border-radius: 50px; border: 1px solid var(--glass-border);
            box-shadow: 0 4px 15px rgba(0,0,0,0.5); pointer-events: auto;
        }
        .nav-btn { 
            background: none; border: none; color: var(--text-muted); font-size: 15px; 
            cursor: pointer; padding: 8px 16px; border-radius: 30px; transition: all 0.3s; 
        }
        .nav-btn:hover, .nav-btn.active { 
            background-color: rgba(204, 0, 0, 0.8); color: white; box-shadow: 0 0 10px rgba(204, 0, 0, 0.5);
        }

        /* HEADER SAĞ BÖLÜM (Sosyal & Dil) */
        .header-right {
            position: absolute; right: 30px; top: 50%; transform: translateY(-50%);
            display: flex; align-items: center; gap: 20px; pointer-events: auto;
        }
        .social-icons { display: flex; gap: 12px; }
        .social-icons a, .social-icons span {
            color: var(--text-muted); cursor: pointer; transition: 0.3s;
            display: flex; align-items: center; justify-content: center;
        }
        .social-icons a:hover, .social-icons span:hover {
            color: white; transform: scale(1.15); filter: drop-shadow(0 0 8px rgba(255, 255, 255, 0.5));
        }

        /* KAYAN ANİMASYONLU DİL SEÇİCİ */
        .lang-switcher {
            position: relative; display: flex; background: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--glass-border); border-radius: 30px; padding: 4px; box-shadow: inset 0 2px 5px rgba(0,0,0,0.5);
        }
        .lang-slider {
            position: absolute; top: 4px; left: 4px; width: 32px; height: calc(100% - 8px);
            background: var(--vintage-red); border-radius: 20px; transition: transform 0.3s cubic-bezier(0.25, 1, 0.5, 1);
            z-index: 0; box-shadow: 0 0 10px rgba(204, 0, 0, 0.6);
        }
        .lang-opt {
            position: relative; z-index: 1; width: 32px; text-align: center; font-size: 11px; font-weight: 800;
            color: var(--text-muted); line-height: 22px; cursor: pointer; transition: color 0.3s; user-select: none;
        }
        .lang-opt.active { color: white; }
        
        .container { max-width: 1100px; margin: 120px auto 30px; padding: 20px; }
        .section { display: none; animation: fadeIn 0.4s ease; }
        .section.active { display: block; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(15px); } to { opacity: 1; transform: translateY(0); } }

        /* BUTONLAR VE İNPUTLAR */
        .btn { padding: 12px 24px; border: none; border-radius: var(--border-radius); cursor: pointer; font-size: 14px; transition: 0.3s; color: white; display: inline-flex; align-items: center; justify-content: center; gap: 8px; }
        .btn-primary { background-color: var(--vintage-red); }
        .btn-primary:hover { background-color: var(--vintage-red-hover); box-shadow: 0 0 10px var(--vintage-red-hover); }
        .btn-green { background-color: var(--green); }
        .btn-green:hover { background-color: #3cb371; }
        .btn-admin { background-color: #333; }
        .btn-admin:hover { background-color: #444; }
        .btn-danger { background-color: #990000; }
        .btn-danger:hover { background-color: #cc0000; }
        
        input, select, textarea { 
            width: 100%; padding: 12px; margin-top: 8px; margin-bottom: 15px; 
            border-radius: 12px; border: 1px solid #333; background-color: rgba(0,0,0,0.5); 
            color: white; outline: none; backdrop-filter: blur(5px); font-family: 'Poppins', sans-serif;
        }
        input:focus, textarea:focus { border-color: var(--vintage-red); box-shadow: 0 0 8px rgba(204,0,0,0.5); }
        
        .admin-only { display: none; border: 1px dashed var(--vintage-red); padding: 20px; border-radius: var(--border-radius); margin-bottom: 25px; background-color: rgba(139, 0, 0, 0.1); backdrop-filter: blur(5px); }

        .category-container { display: flex; gap: 10px; overflow-x: auto; padding: 12px 20px; margin-bottom: 30px; background: rgba(255, 255, 255, 0.03); backdrop-filter: blur(10px); border-radius: 50px; border: 1px solid var(--glass-border); justify-content: center; }
        .menu-tab { background: transparent; color: var(--text-muted); padding: 8px 18px; border-radius: 30px; cursor: pointer; transition: 0.3s; display: flex; align-items: center; gap: 8px; font-size: 14px; border: none; }
        .menu-tab:hover { color: white; text-shadow: 0 0 8px rgba(255,255,255,0.8); }
        .menu-tab.active { background-color: var(--vintage-red); color: white; box-shadow: 0 0 10px var(--vintage-red); }
        
        .glass-item-card { background: var(--glass-bg); backdrop-filter: blur(15px); -webkit-backdrop-filter: blur(15px); border: 1px solid var(--glass-border); border-radius: 20px; padding: 20px; transition: 0.3s; display: flex; justify-content: space-between; align-items: center; }
        .glass-item-card:hover { border-color: rgba(204,0,0,0.4); transform: translateX(5px); box-shadow: 0 5px 15px rgba(204,0,0,0.2); }
        
        .grid-home { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 20px; }
        .event-card-home { background: var(--glass-bg); backdrop-filter: blur(10px); border: 1px solid var(--glass-border); border-radius: var(--border-radius); padding: 20px; transition: all 0.3s; cursor: pointer; }
        .event-card-home:hover { transform: translateY(-8px); box-shadow: 0 12px 25px rgba(204, 0, 0, 0.4); border-color: var(--vintage-red); }

        /* Takvim */
        .calendar-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: 15px; margin-top: 20px; }
        .cal-day { aspect-ratio: 1; border-radius: 15px; position: relative; overflow: hidden; background: #111; cursor: pointer; transition: all 0.3s; border: 2px solid transparent; }
        .cal-bg { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background-size: cover; background-position: center; background-image: linear-gradient(to top, rgba(0,0,0,1) 0%, rgba(0,0,0,0.3) 100%); transition: 0.3s; z-index: 1; }
        .cal-day:hover { transform: translateY(-8px); border-color: var(--vintage-red); box-shadow: 0 0 20px rgba(204, 0, 0, 0.7); }
        .cal-day:hover .cal-bg { transform: scale(1.1); }
        .day-num { position: absolute; top: 8px; left: 8px; background: rgba(0,0,0,0.8); color: white; padding: 2px 8px; border-radius: 8px; font-size: 14px; z-index: 2; border: 1px solid #333; }
        
        /* SİSTEM TASARIMI İLE UYUMLU ÖZEL POP-UP (MODAL) ALTYAPISI */
        .sys-modal-overlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.85); backdrop-filter: blur(12px);
            display: none; justify-content: center; align-items: center; z-index: 9999;
        }
        .sys-modal-content {
            background: #111; border: 1px solid var(--vintage-red); border-radius: 25px; padding: 30px; 
            width: 90%; max-width: 450px; text-align: center; position: relative; 
            box-shadow: 0 0 40px rgba(204,0,0,0.4); animation: popIn 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            display: flex; flex-direction: column;
        }
        @keyframes popIn { from { transform: scale(0.8); opacity: 0; } to { transform: scale(1); opacity: 1; } }
        .sys-close-modal { position: absolute; top: 15px; right: 20px; font-size: 24px; color: var(--text-muted); cursor: pointer; }
        .sys-close-modal:hover { color: white; }
        ::-webkit-calendar-picker-indicator { filter: invert(1); cursor: pointer; }

        /* FOOTER (ALT BİLGİ) STİLLERİ */
        .site-footer {
            max-width: 1100px; margin: 60px auto 20px auto; padding: 0 20px;
            text-align: center; clear: both;
        }
        .site-footer hr { border: none; border-top: 1px solid rgba(255, 255, 255, 0.1); margin-bottom: 15px; }
        .site-footer p { color: #777777; font-size: 12px; font-weight: 400; letter-spacing: 0.5px; }

       /* =========================================
           MOBİL UYUM (RESPONSIVE DESIGN) EKLENTİLERİ
           ========================================= */
        @media screen and (max-width: 768px) {
            header {
                display: flex; flex-direction: column; justify-content: flex-end;
                height: auto; padding: 15px; background: rgba(5, 5, 5, 0.95); 
                backdrop-filter: blur(10px); pointer-events: auto;
            }
            .logo-image { position: absolute; top: 15px; left: 15px; transform: none; width: 40px; height: 40px; margin: 0; }
            .header-right { position: absolute; top: 18px; right: 15px; transform: none; gap: 12px; }
            .social-icons svg { width: 18px; height: 18px; }

            .floating-nav {
                position: relative; transform: none; left: 0; top: 0; width: 100%; background: transparent;
                border: none; box-shadow: none; padding: 0; gap: 5px; margin-top: 45px; 
                justify-content: center; flex-wrap: wrap;
            }
            .nav-btn { font-size: 11px; padding: 6px 8px; background: rgba(255, 255, 255, 0.05); border: 1px solid var(--glass-border); white-space: nowrap; flex: 1 1 auto; text-align: center; }
            .container { margin-top: 130px; padding: 15px; }

            #home h1 { font-size: 28px !important; margin-top: 0; }
            #home h3 { font-size: 22px !important; margin-bottom: 20px; }

            #upcomingEventsGrid {
                display: flex !important; flex-wrap: nowrap; overflow-x: auto; overflow-y: hidden;
                scroll-snap-type: x mandatory; gap: 15px; padding-bottom: 15px; -webkit-overflow-scrolling: touch;
            }
            #upcomingEventsGrid::-webkit-scrollbar { display: none; }
            
            .event-card-home {
                flex: 0 0 200px; height: 200px; display: flex; flex-direction: column;
                scroll-snap-align: start; padding: 12px; margin: 0;
            }
            .event-card-home img { width: 100%; flex: 1; object-fit: cover; border-radius: 10px; margin-bottom: 10px !important; height: 100px !important; }
            .event-card-home h4 { font-size: 14px !important; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
            .event-card-home p { font-size: 11px !important; margin-top: 2px !important; }

            .category-container { justify-content: flex-start; padding: 10px; border-radius: 20px; }
            .menu-tab { font-size: 12px; padding: 6px 12px; }

            #menuItemsGrid .glass-item-card { flex-direction: row !important; align-items: center !important; padding: 12px; }
            #menuItemsGrid .glass-item-card h3 { font-size: 14px !important; }
            #menuItemsGrid .glass-item-card p { font-size: 11px !important; line-height: 1.3; margin-top: 3px; color: #aaa !important; }
            #menuItemsGrid .glass-item-card > div:last-child { margin-left: 10px !important; margin-top: 0 !important; font-size: 14px !important; }
            #menuItemsGrid .glass-item-card > div:first-child > div { flex-wrap: wrap; }

            #pendingReservations .glass-item-card, #approvedReservations .glass-item-card {
                display: flex !important; flex-direction: column !important; align-items: flex-start !important;
                width: 100% !important; padding: 15px !important; box-sizing: border-box !important;
            }
            #pendingReservations .glass-item-card p, #pendingReservations .glass-item-card h4,
            #approvedReservations .glass-item-card p, #approvedReservations .glass-item-card h4 {
                max-width: 100%; word-wrap: break-word; white-space: normal; 
            }

            #customerResView { flex-direction: column !important; align-items: stretch !important; width: 100% !important; box-sizing: border-box !important; }
            #adminEventControls[style*="block"], #adminMenuControls[style*="block"] {
                display: flex !important; flex-direction: column !important; align-items: stretch !important; width: 100% !important; box-sizing: border-box !important;
            }

            /* İnput Görünümlü Kutular (Tarih Butonu ve Yeni Etkinlik Balonu) - Yan Yana Dizilim Korunsun */
            #customerResView > .glass-item-card, #adminEventControls > .glass-item-card {
                display: flex !important; flex-direction: row !important; justify-content: space-between !important; align-items: center !important;
                width: 100% !important; box-sizing: border-box !important; padding: 12px !important; margin-top: 8px !important; margin-bottom: 15px !important;
                border-radius: 12px !important; border: 1px solid #333 !important; background-color: rgba(0,0,0,0.5) !important; box-shadow: none !important; height: auto;
            }
            #resDate_display, #eventDate_display { font-size: 13.5px !important; font-weight: 400 !important; color: var(--text-muted); }
            
            .calendar-grid { grid-template-columns: repeat(auto-fill, minmax(80px, 1fr)); gap: 10px; }
            .day-num { font-size: 12px; padding: 2px 6px; }
            .sys-modal-content { width: 95%; padding: 20px; }
            #pickerGrid { gap: 3px !important; }
            #pickerGrid .cal-day { font-size: 12px !important; border-radius: 6px !important; }
        }
    </style>